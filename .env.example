# GitHub (used by code-local and code-gitlab backups)
GITHUB_TOKEN=""
GITHUB_USERNAME=""
USE_GITHUB_SSH="false"

# GitHub security report (github:security-report)
# Optional: dedicate a PAT to this tool (falls back to GITHUB_TOKEN above).
# The token needs read access to security alerts, e.g. a classic PAT with the
# security_events (or repo) scope, or a fine-grained PAT with Dependabot
# alerts and Code scanning alerts read permissions.
GITHUB_SECURITY_TOKEN=""

# Optional: profile shown in the report (default: garretpatten). Repos are
# always read from the account owning the token.
GITHUB_SECURITY_USERNAME="garretpatten"

# Optional: directory for the dated report (default: $HOME)
GITHUB_SECURITY_REPORT_DIR=""

# GitLab (used by code-gitlab backup)
GITLAB_TOKEN=""
GITLAB_NAMESPACE=""
AUTO_CREATE_GITLAB_PROJECTS="true"
GITLAB_VISIBILITY="private"
GITLAB_HOST="https://gitlab.com"
BACKUP_ROOT="$HOME/GitHub-GitLab-Backup"

# Google (used by google-calendar and google-tasks backups)
# OAuth 2.0 credentials for an installed/desktop app. The refresh token is
# obtained automatically via a one-time browser authorization the first time
# you run either Google backup, and is saved back to this file.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_CALENDAR_SHOW_DELETED="false"
GOOGLE_TASKS_SHOW_COMPLETED="true"
GOOGLE_TASKS_SHOW_DELETED="true"
GOOGLE_TASKS_SHOW_HIDDEN="true"

# Notion (used by notion backup)
NOTION_API_TOKEN=""

