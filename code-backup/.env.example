# Copy this file to .env and fill in your real values.
# code-backup/.env is ignored by Git so tokens are not committed.

# GitHub
GITHUB_USERNAME="your-github-username"
GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# GitLab (required only by code-backup-gitlab.sh)
GITLAB_TOKEN="glpat-xxxxxxxxxxxxxxxxxxxxxxxxxx"
GITLAB_NAMESPACE="your-gitlab-username-or-group"

# Optional: use SSH instead of HTTPS for GitHub clones
# USE_GITHUB_SSH="true"

# Optional: custom local backup directory for code-backup-local.sh
# PROJECTS_DIR="$HOME/MyProjects"

# Optional: GitLab mirror settings (used by code-backup-gitlab.sh)
# AUTO_CREATE_GITLAB_PROJECTS="true"
# GITLAB_VISIBILITY="private"
# GITLAB_HOST="https://gitlab.com"
# BACKUP_ROOT="$HOME/GitHub-GitLab-Backup"
